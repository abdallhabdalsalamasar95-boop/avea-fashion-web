# Example env file (safe to commit)
# Telegram Bot config
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_token_here
TELEGRAM_CHAT_ID=123456789
 
# Ads (AdMob)
ADS_ENABLED=1
ADMOB_BANNER_ID_ANDROID=
ADMOB_BANNER_ID_IOS=

# Interstitial
ADMOB_INTERSTITIAL_ID_ANDROID=
ADMOB_INTERSTITIAL_ID_IOS=

# Rewarded (Watch & Earn)
ADMOB_REWARDED_ID_ANDROID=
ADMOB_REWARDED_ID_IOS=

# Local LAN catalog server (optional)
# Example: http://192.168.1.50:8080
LOCAL_CATALOG_BASE_URL=https://carmenkarla-backend.onrender.com
# Admin panel URL will be: https://carmenkarla-backend.onrender.com/admin
LOCAL_CATALOG_API_TOKEN=

# Web monetization (Google AdSense)
# Example publisher id: ca-pub-1234567890123456
ADSENSE_CLIENT=
# Example ad slot id from AdSense unit (numbers only)
# Optional if you only use Auto Ads.
ADSENSE_SLOT=
